CC = gcc
CFLAGS = -Wall
LDFLAGS = -lrt -lpthread
TARGET = program

all: $(TARGET)

$(TARGET): main.o server.o worker.o
	$(CC) $(CFLAGS) -o $(TARGET) main.o server.o worker.o $(LDFLAGS)

main.o: main.c server.h worker.h
	$(CC) $(CFLAGS) -c main.c

server.o: server.c server.h
	$(CC) $(CFLAGS) -c server.c

worker.o: worker.c worker.h
	$(CC) $(CFLAGS) -c worker.c

clean:
	rm -f *.o $(TARGET)
	rm -f /dev/shm/shm

run_server: $(TARGET)
	./$(TARGET) server

run_worker: $(TARGET)
	./$(TARGET) worker
